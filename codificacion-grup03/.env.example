# ==============================================================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO - EPICENTRO GOURMET
# ==============================================================================
# Instrucciones:
# 1. Copiá este archivo y renombralo como '.env' en la raíz del módulo:
#    cp .env.example .env
# 2. Completá los valores según tu entorno local.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BASE DE DATOS (MySQL)
# ------------------------------------------------------------------------------
# URL de conexión JDBC hacia tu base de datos MySQL local o remota.
# Asegurate de que la base  ghsicilianotfi? exista previamente creada en MySQL:
# CREATE DATABASE IF NOT EXISTS ghsicilianotfi CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DB_URL=jdbc:mysql://localhost:3306/ghsicilianotfi?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# Usuario de MySQL (por defecto suele ser 'root')
DB_USERNAME=root

# Contraseña de tu usuario de MySQL
DB_PASSWORD=tu_password_aqui


# ------------------------------------------------------------------------------
# 2. SERVICIO DE CORREO ELECTRÓNICO (Gmail SMTP)
# ------------------------------------------------------------------------------
# Se utiliza para el envío asíncrono de credenciales de acceso a nuevos usuarios/empleados.
# Nota: Para Gmail no se usa la contraseña habitual, sino una 'Contraseña de aplicación' de 16 caracteres.
# (Configuración de Google -> Seguridad -> Verificación en 2 pasos -> Contraseñas de aplicaciones).

# Correo electrónico de envío
MAIL_USERNAME=tu_email@gmail.com

# Contraseña de aplicación generada en tu cuenta de Google (16 caracteres, ej: abcd efgh ijkl mnop)
MAIL_PASSWORD=tu_app_password_de_16_caracteres

